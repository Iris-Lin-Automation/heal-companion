# OpenAI-compatible API (OpenAI / DeepSeek / Moonshot / 本地网关均可)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Companion display name
COMPANION_NAME=heal

# 火山引擎多情感 TTS (OpenSpeech)
# https://openspeech.bytedance.com/api/v1/tts
VOLC_APPID=
VOLC_TOKEN=
VOLC_VOICE_TYPE=zh_male_taocheng_uranus_bigtts
VOLC_SPEED_RATIO=1.04
VOLC_PITCH_RATIO=1.03
VOLC_CLUSTER=volcano_tts

# Supabase Auth + Postgres。anon key 可以进前端；service role 只放后端。
# 建好项目后，把 supabase/migrations/001_identity_and_memory.sql 贴进 SQL Editor 执行。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
# 邮件确认跳转地址；不要用 127.0.0.1，手机打不开
VITE_SITE_URL=https://heal-companion.onrender.com

# Web API: uvicorn api.server:app --port 8787
# Branded UI: cd web && npm run dev  → http://localhost:5173
# Optional mature UI: docker compose up  → Open WebUI :3000
